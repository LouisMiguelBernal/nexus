# === Nexus Environment Variables ===
# Copy to .env and fill in your keys manually.
# NEVER commit .env to version control.

# --- Binance (Derivatives / USDS-M focused) ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# --- BloFin (CCXT paper trading) ---
# App: CCXT | Key Name: nexus | Permissions: READ,TRADE
BLOFIN_API_KEY=your_blofin_api_key_here
BLOFIN_SECRET=your_blofin_secret_here
BLOFIN_PASSPHRASE=nexus

# --- CoinMarketCap (free tier) ---
CMC_API_KEY=your_coinmarketcap_api_key_here

# --- FRED (free) ---
FRED_API_KEY=your_fred_api_key_here

# --- Finnhub (free tier) ---
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Etherscan (free tier) ---
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
